// ─── Auth Context ──────────────────────────────────────────────
const AuthContext = createContext(null);
function AuthProvider({children}) {
  const [user, setUser] = useState(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    const session = DB.getSession();
    if(session && session.user) {
      setUser(session.user);
    }
    setLoading(false);
  }, []);

  const signUp = useCallback(async (email, password, name) => {
    const users = DB.getAll('users');
    if(users.find(u=>u.email===email)) return {error:'An account with this email already exists'};
    const user = {id:uid(), email, name, created_at:now()};
    const profile = {id:user.id, email, name, pin:'1234', created_at:now(), updated_at:now()};
    DB.insert('users', {...user, password});
    DB.insert('profiles', profile);
    DB.insert('parent_settings', {id:uid(), parent_id:user.id, default_sleep_timer:15, allow_downloads:true, created_at:now()});
    DB.setSession({user, access_token:uid()});
    setUser(user);
    return {user};
  }, []);

  const signIn = useCallback(async (email, password) => {
    const users = DB.getAll('users');
    const found = users.find(u=>u.email===email && u.password===password);
    if(!found) return {error:'Invalid email or password'};
    const user = {id:found.id, email:found.email, name:found.name};
    DB.setSession({user, access_token:uid()});
    setUser(user);
    return {user};
  }, []);

  const signOut = useCallback(() => {
    DB.clearSession();
    setUser(null);
  }, []);

  const updateProfile = useCallback((updates) => {
    if(!user) return;
    DB.update('profiles', user.id, updates);
  }, [user]);

  const getProfile = useCallback(() => {
    if(!user) return null;
    return DB.getById('profiles', user.id);
  }, [user]);

  return <AuthContext.Provider value={{user,loading,signUp,signIn,signOut,updateProfile,getProfile}}>{children}</AuthContext.Provider>;
}
function useAuth() { return useContext(AuthContext); }

