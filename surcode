// ─── Audio Engine (real Web Audio API) ─────────────────────────
const AudioEngine = {
  ctx: null,
  audio: null,
  _listeners: {},
  init() {
    if(!this.audio) {
      this.audio = new Audio();
      this.audio.crossOrigin = 'anonymous';
    }
    return this.audio;
  },
  async play(src) {
    const a = this.init();
    if(src) a.src = src;
    try { await a.play(); return true; } catch(e) { console.warn('Audio play failed:', e); return false; }
  },
  pause() { const a=this.init(); a.pause(); },
  resume() { const a=this.init(); if(a.src) a.play().catch(()=>{}); },
  stop() { const a=this.init(); a.pause(); a.currentTime=0; },
  seek(time) { const a=this.init(); a.currentTime=time; },
  setVolume(v) { const a=this.init(); a.volume=clamp(v,0,1); },
  setSpeed(s) { const a=this.init(); a.playbackRate=clamp(s,0.5,2); },
  getProgress() { const a=this.init(); return a.duration?{current:a.currentTime,total:a.duration,percent:(a.currentTime/a.duration)*100}:{current:0,total:0,percent:0}; },
  isPlaying() { const a=this.init(); return !a.paused; },
  getAudio() { return this.init(); },
  // Generate a calming demo tone
  generateDemoAudio(durationSec=30) {
    const sampleRate = 22050;
    const numSamples = sampleRate * durationSec;
    const ctx = new (window.AudioContext||window.webkitAudioContext)({sampleRate});
    const buffer = ctx.createBuffer(1, numSamples, sampleRate);
    const data = buffer.getChannelData(0);
    // Gentle harmonic lullaby pattern
    const notes = [261.63,293.66,329.63,349.23,392.00,349.23,329.63,293.66]; // C D E F G F E D
    const noteLen = sampleRate * 2;
    for(let i=0;i<numSamples;i++){
      const noteIdx = Math.floor(i/noteLen) % notes.length;
      const freq = notes[noteIdx];
      const t = i/sampleRate;
      const env = Math.sin(Math.PI*(i%noteLen)/noteLen);
      data[i] = 0.3 * env * Math.sin(2*Math.PI*freq*t) + 0.1 * env * Math.sin(2*Math.PI*freq*2*t);
    }
    const blob = new Promise(resolve => {
      const offCtx = new OfflineAudioContext(1, numSamples, sampleRate);
      const src = offCtx.createBufferSource();
      src.buffer = buffer;
      src.connect(offCtx.destination);
      src.start();
      offCtx.startRendering().then(rendered => {
        const wav = audioBufferToWav(rendered);
        resolve(new Blob([wav],{type:'audio/wav'}));
      });
    });
    return blob;
  }
};

// Convert AudioBuffer to WAV
function audioBufferToWav(buffer) {
  const numCh=buffer.numberOfChannels, sr=buffer.sampleRate, bps=16;
  const bytesPerSample=bps/8, blockAlign=numCh*bytesPerSample;
  const data=[];
  for(let ch=0;ch<numCh;ch++) data.push(buffer.getChannelData(ch));
  const length=data[0].length;
  const dataSize=length*blockAlign;
  const header=new ArrayBuffer(44+dataSize);
  const view=new DataView(header);
  function writeString(offset,str){for(let i=0;i<str.length;i++)view.setUint8(offset+i,str.charCodeAt(i));}
  writeString(0,'RIFF');view.setUint32(4,36+dataSize,true);writeString(8,'WAVE');
  writeString(12,'fmt ');view.setUint32(16,16,true);view.setUint16(20,1,true);view.setUint16(22,numCh,true);
  view.setUint32(24,sr,true);view.setUint32(28,sr*blockAlign,true);view.setUint16(32,blockAlign,true);view.setUint16(34,bps,true);
  writeString(36,'data');view.setUint32(40,dataSize,true);
  let offset=44;
  for(let i=0;i<length;i++){
    for(let ch=0;ch<numCh;ch++){
      const sample=Math.max(-1,Math.min(1,data[ch][i]));
      view.setInt16(offset,sample<0?sample*0x8000:sample*0x7FFF,true);
      offset+=2;
    }
  }
  return header;
}

// ─── Download Manager (IndexedDB) ──────────────────────────────
const DownloadManager = {
  db: null,
  async init() {
    return new Promise((resolve) => {
      const req = indexedDB.open('dreamspecial_downloads', 1);
      req.onupgradeneeded = (e) => { e.target.result.createObjectStore('files',{keyPath:'id'}); };
      req.onsuccess = (e) => { this.db=e.target.result; resolve(); };
      req.onerror = () => { this.db=null; resolve(); };
    });
  },
  async save(id, blob, meta) {
    if(!this.db) return false;
    return new Promise((resolve) => {
      const tx=this.db.transaction('files','readwrite');
      tx.objectStore('files').put({id,blob,meta,savedAt:now()});
      tx.oncomplete=()=>resolve(true);
      tx.onerror=()=>resolve(false);
    });
  },
  async get(id) {
    if(!this.db) return null;
    return new Promise((resolve) => {
      const tx=this.db.transaction('files','readonly');
      const req=tx.objectStore('files').get(id);
      req.onsuccess=()=>resolve(req.result||null);
      req.onerror=()=>resolve(null);
    });
  },
  async remove(id) {
    if(!this.db) return;
    return new Promise((resolve) => {
      const tx=this.db.transaction('files','readwrite');
      tx.objectStore('files').delete(id);
      tx.oncomplete=()=>resolve();
      tx.onerror=()=>resolve();
    });
  },
  async getAll() {
    if(!this.db) return [];
    return new Promise((resolve) => {
      const tx=this.db.transaction('files','readonly');
      const req=tx.objectStore('files').getAll();
      req.onsuccess=()=>resolve(req.result||[]);
      req.onerror=()=>resolve([]);
    });
  }
};
DownloadManager.init();

// ─── Voice Recorder (real MediaRecorder) ───────────────────────
const VoiceRecorder = {
  mediaRec: null,
  chunks: [],
  stream: null,
  async start() {
    try {
      this.stream = await navigator.mediaDevices.getUserMedia({audio:true});
      this.chunks = [];
      this.mediaRec = new MediaRecorder(this.stream);
      this.mediaRec.ondataavailable = (e) => { if(e.data.size>0) this.chunks.push(e.data); };
      this.mediaRec.start();
      return true;
    } catch(e) { console.warn('Mic access denied:', e); return false; }
  },
  stop() {
    return new Promise((resolve) => {
      if(!this.mediaRec) return resolve(null);
      this.mediaRec.onstop = () => {
        const blob = new Blob(this.chunks, {type:'audio/webm'});
        if(this.stream) this.stream.getTracks().forEach(t=>t.stop());
        this.mediaRec=null; this.stream=null;
        resolve(blob);
      };
      this.mediaRec.stop();
    });
  },
  isRecording() { return this.mediaRec && this.mediaRec.state==='recording'; }
};

