  };

  return (
    <div className="h-full screen-scroll bg-moon-cream pb-8">
      <Header title="Edit Profile" onBack={()=>navigate('parent-dashboard')}/>
      <div className="px-5 mt-2 space-y-4">
        <div className="text-center py-4"><div className="text-5xl">{child?.avatar||'🧒'}</div></div>
        <div><label className="text-sm font-semibold text-midnight-plum/70 mb-1 block">Name</label><input type="text" value={name} onChange={e=>setName(e.target.value)} className="w-full px-4 py-3 rounded-xl bg-white border border-cloud-lavender/50 text-midnight-plum focus:border-dream-violet transition-all"/></div>
        <div><label className="text-sm font-semibold text-midnight-plum/70 mb-1 block">Age</label><div className="flex gap-2 flex-wrap">{[3,4,5,6,7,8,9,10].map(a=><button key={a} onClick={()=>setAge(String(a))} className={`w-10 h-10 rounded-xl font-bold ${age===String(a)?'bg-dream-violet text-white':'bg-white text-midnight-plum border border-cloud-lavender/50'}`}>{a}</button>)}</div></div>
        <div><label className="text-sm font-semibold text-midnight-plum/70 mb-1 block">Bedtime</label><input type="time" value={bedtime} onChange={e=>setBedtime(e.target.value)} className="w-full px-4 py-3 rounded-xl bg-white border border-cloud-lavender/50 text-midnight-plum focus:border-dream-violet transition-all"/></div>
        <Button onClick={handleSave} full size="lg">Save Changes</Button>
      </div>
    </div>
  );
}


// ═══════════════════════════════════════════════════════════════
//  MAIN APP
// ═══════════════════════════════════════════════════════════════
function App() {
  return (
    <AuthProvider>
      <AppProvider>
        <PlayerProvider>
          <AppInner/>
        </PlayerProvider>
      </AppProvider>
    </AuthProvider>
  );
}

function AppInner() {
  const {screen} = useApp();
  const {loading} = useAuth();
  const {story} = usePlayer();

  if(loading) return <div className="h-full flex items-center justify-center bg-moon-cream"><Loading/></div>;

  const screens = {
    'splash': SplashScreen,
    'welcome': WelcomeScreen,
    'login': LoginScreen,
    'signup': SignupScreen,
    'forgot-password': ForgotPasswordScreen,
    'parent-setup': ParentSetupScreen,
    'child-profile': ChildProfileScreen,
    'language-select': LanguageSelectScreen,
    'home': HomeScreen,
    'stories': StoryLibraryScreen,
    'story-detail': StoryDetailScreen,
    'player': PlayerScreen,
    'downloads': DownloadsScreen,
    'parent-gate': ParentGateScreen,
    'parent-dashboard': ParentDashboardScreen,
    'family-voices': FamilyVoicesScreen,
    'sleep-settings': SleepSettingsScreen,
    'language-settings': LanguageSettingsScreen,
    'pin-settings': PinSettingsScreen,
    'child-edit': ChildEditScreen
  };

  const ScreenComponent = screens[screen] || HomeScreen;
  const showNav = !['splash','welcome','login','signup','forgot-password','parent-setup','child-profile','language-select','player'].includes(screen);

  return (
    <div className="h-full w-full max-w-lg mx-auto relative bg-moon-cream overflow-hidden">
      <div className="h-full overflow-hidden">
        <ScreenComponent/>
      </div>
      {showNav && screen!=='player' && <BottomNav/>}
      {showNav && story && screen!=='player' && <MiniPlayer/>}
      <Toast/>
    </div>
  );
}

// ─── Render ────────────────────────────────────────────────────
const root = ReactDOM.createRoot(document.getElementById('root'));
root.render(<App/>);
</script>
</body>
</html>
