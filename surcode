// ─── Story Player ──────────────────────────────────────────────
function PlayerScreen() {
  const {params, navigate, activeChild, showToast} = useApp();
  const {playing, story, voice, progress, volume, speed, sleepTimer, timerRemaining, playStory, togglePlay, stop, seek, setVolume, setSpeed, startSleepTimer, clearSleepTimer} = usePlayer();
  const [audioReady, setAudioReady] = useState(false);
  const [showTimer, setShowTimer] = useState(false);
  const [showSpeed, setShowSpeed] = useState(false);
  const [showVol, setShowVol] = useState(false);
  const progressRef = useRef(null);
  const audioUrlRef = useRef(null);

  useEffect(()=>{
    const loadAndPlay = async () => {
      const storyObj = DB.getById('stories', params.storyId);
      if(!storyObj) return;

      let voiceObj = {id:'default', name:'Default Narrator', avatar:'🎙️', relationship:'Professional'};
      if(params.voiceId && params.voiceId !== 'default') {
        const allVoices = DB.getAll('family_voices');
        const fv = allVoices.find(v=>v.id===params.voiceId);
        if(fv) {
          const member = DB.getById('family_members', fv.family_member_id);
          voiceObj = {...fv, name:fv.voice_name, avatar:member?.avatar||'🎤', relationship:member?.relationship||''};
        }
      }

      // Check for stored audio URL for this voice+story combo
      const audioLinks = DB.getStoryAudio(params.storyId, params.voiceId);
      let audioSrc = null;
      if(audioLinks.length>0 && audioLinks[0].audio_url) {
        audioSrc = audioLinks[0].audio_url;
      }

      // Check IndexedDB for downloaded audio
      if(!audioSrc) {
        const dl = await DownloadManager.get(`audio_${params.storyId}_${params.voiceId}`);
        if(dl && dl.blob) {
          audioSrc = URL.createObjectURL(dl.blob);
        }
      }

      // If no real audio, generate a demo calming tone
      if(!audioSrc) {
        try {
          const blob = await AudioEngine.generateDemoAudio(storyObj.duration * 60);
          audioSrc = URL.createObjectURL(blob);
          audioUrlRef.current = audioSrc;
        } catch(e) {
          // Fallback: create a very simple tone
          console.warn('Could not generate demo audio, using silent fallback');
        }
      }

      await playStory(storyObj, voiceObj, audioSrc);
      setAudioReady(true);

      // Record listening history
      if(activeChild) {
        DB.insert('listening_history', {id:uid(), child_id:activeChild.id, story_id:params.storyId, voice_id:params.voiceId, start_time:now(), end_time:null, duration:0, completed:false, created_at:now()});
      }
    };

    loadAndPlay();

    return ()=>{
      if(audioUrlRef.current) {
        URL.revokeObjectURL(audioUrlRef.current);
      }
    };
  },[params.storyId, params.voiceId]);

  const handleSeek = (e) => {
    const rect = e.currentTarget.getBoundingClientRect();
    const pct = clamp((e.clientX - rect.left)/rect.width, 0, 1);
    const audio = AudioEngine.getAudio();
    if(audio && audio.duration) {
      seek(pct * audio.duration);
    }
  };

  const handleClose = () => {
    stop();
    navigate('story-detail', {storyId: params.storyId});
  };

  if(!story) return <div className="h-full flex items-center justify-center bg-midnight-plum"><Loading/></div>;

  return (
    <div className="h-full flex flex-col bg-gradient-to-b from-midnight-plum via-midnight-plum-light to-midnight-plum text-white">
      {/* Top bar */}
      <div className="flex items-center justify-between px-5 pt-4 pb-2">
        <button onClick={handleClose} className="w-9 h-9 rounded-full bg-white/10 flex items-center justify-center active:scale-90">✕</button>
        <div className="text-sm font-semibold text-white/60">Now Playing</div>
        <button onClick={()=>setShowTimer(!showTimer)} className={`w-9 h-9 rounded-full flex items-center justify-center active:scale-90 ${sleepTimer?'bg-moon-mango/30':'bg-white/10'}`}>🌙</button>
      </div>

      {/* Cover */}
      <div className="flex-1 flex flex-col items-center justify-center px-8">
        <div className="w-56 h-56 rounded-3xl overflow-hidden shadow-2xl shadow-dream-violet/30 mb-6 animate-fade-in">
          <img src={story.cover} className="w-full h-full object-cover"/>
        </div>
        <h2 className="font-display font-bold text-xl text-center animate-fade-in">{story.title}</h2>
        <p className="text-white/50 text-sm mt-1">{voice?.name||'Default Narrator'}</p>
      </div>

      {/* Sleep Timer Panel */}
      {showTimer && (
        <div className="px-5 pb-4 animate-fade-in">
          <SleepTimerComponent
            active={!!sleepTimer}
            remaining={timerRemaining}
            onSelect={(mins)=>{
              if(mins===0) { /* end of story */ showToast('Will stop at end of story','success'); }
              else { startSleepTimer(mins); showToast(`Sleep timer: ${mins} min`,'success'); }
              setShowTimer(false);
            }}
          />
          {sleepTimer && <Button variant="ghost" size="sm" onClick={()=>{clearSleepTimer();showToast('Timer cancelled','info');}} full className="mt-2 !text-white/60">Cancel Timer</Button>}
        </div>
      )}

      {/* Progress */}
      <div className="px-5 pb-2">
        <div ref={progressRef} onClick={handleSeek} className="w-full h-2 bg-white/20 rounded-full cursor-pointer relative">
          <div className="h-full bg-moon-mango rounded-full transition-all duration-300" style={{width:`${progress.percent}%`}}/>
        </div>
        <div className="flex justify-between text-xs text-white/40 mt-1">
          <span>{fmtTime(progress.current)}</span>
          <span>{fmtTime(progress.total)}</span>
        </div>
      </div>

      {/* Controls */}
      <div className="flex items-center justify-center gap-6 px-5 pb-4">
        <button onClick={()=>setShowSpeed(!showSpeed)} className="text-white/60 text-sm font-bold w-10 text-center">{speed}x</button>
