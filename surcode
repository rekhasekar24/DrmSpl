  insert(table, record) { const data=this._get(table); data.push(record); this._set(table,data); return record; },
  update(table, id, updates) { const data=this._get(table); const idx=data.findIndex(r=>r.id===id); if(idx>=0){data[idx]={...data[idx],...updates,updated_at:now()};this._set(table,data);return data[idx];}return null; },
