// ─── Family Voices Screen ──────────────────────────────────────
function FamilyVoicesScreen() {
  const {navigate, showToast} = useApp();
  const {user} = useAuth();
  const [members, setMembers] = useState([]);
  const [showAdd, setShowAdd] = useState(false);
  const [showRecord, setShowRecord] = useState(false);
  const [recordFor, setRecordFor] = useState(null);
  const [isRecording, setIsRecording] = useState(false);
  const [recTime, setRecTime] = useState(0);
  const recInterval = useRef(null);

  useEffect(()=>{ if(user) setMembers(DB.getFamilyMembers(user.id)); },[user]);

  const handleAddMember = (rel) => {
    const member = {id:uid(), parent_id:user.id, name:rel.name, relationship:rel.id, avatar:rel.avatar, created_at:now()};
    DB.insert('family_members', member);
    setMembers(DB.getFamilyMembers(user.id));
    setShowAdd(false);
    showToast(`${rel.name} added!`,'success');
  };

  const startRecording = (member) => {
    setRecordFor(member);
    VoiceRecorder.start().then(ok=>{
      if(ok) {
        setIsRecording(true);
        setRecTime(0);
        recInterval.current = setInterval(()=>setRecTime(t=>t+1), 1000);
        setShowRecord(true);
      } else {
        showToast('Microphone access denied','error');
      }
    });
  };

  const stopRecording = async () => {
    clearInterval(recInterval.current);
    setIsRecording(false);
    const blob = await VoiceRecorder.stop();
    if(blob && recordFor) {
      const audioUrl = URL.createObjectURL(blob);
      // Save to IndexedDB
      await DownloadManager.save(`voice_${recordFor.id}_${Date.now()}`, blob, {memberId:recordFor.id, name:recordFor.name});
      // Create family voice record
      const voice = {id:uid(), family_member_id:recordFor.id, voice_name:`${recordFor.name}'s Voice`, audio_url:audioUrl, language:'en', created_at:now()};
      DB.insert('family_voices', voice);
      showToast(`Voice recorded for ${recordFor.name}!`,'success');
    }
    setShowRecord(false);
    setRecordFor(null);
    setRecTime(0);
  };

  const handleDeleteMember = (memberId) => {
    DB.delete_('family_members', memberId);
    DB.query('family_voices', v=>v.family_member_id===memberId).forEach(v=>DB.delete_('family_voices',v.id));
    setMembers(DB.getFamilyMembers(user.id));
    showToast('Family member removed','info');
  };

  return (
    <div className="h-full screen-scroll bg-moon-cream pb-8">
      <Header title="Family Voices" onBack={()=>navigate('parent-dashboard')}/>

      <div className="px-5 mt-2 space-y-4">
        <p className="text-sm text-midnight-plum/60">Add family members and record their voices. Your child can hear stories in familiar voices.</p>

        {members.length===0 ? (
          <EmptyState icon="🎤" title="No family voices yet" description="Add Amma, Appa, Patti, or Thatha"/>
        ) : (
          <div className="space-y-3">
            {members.map(m=>{
              const voices = DB.getFamilyVoices(m.id);
              return (
                <Card key={m.id}>
                  <div className="flex items-center gap-3">
                    <div className="w-14 h-14 rounded-full bg-cloud-lavender flex items-center justify-center text-3xl">{m.avatar}</div>
                    <div className="flex-1">
                      <div className="font-bold text-midnight-plum">{m.name}</div>
                      <div className="text-xs text-midnight-plum/50">{m.relationship} • {voices.length} voice{voices.length!==1?'s':''}</div>
                    </div>
                  </div>
                  <div className="flex gap-2 mt-3">
                    <Button variant="primary" size="sm" onClick={()=>startRecording(m)} full>Record Voice</Button>
                    <Button variant="outline" size="sm" onClick={()=>handleDeleteMember(m.id)} full>Remove</Button>
                  </div>
                  {voices.length>0 && (
                    <div className="mt-3 space-y-1">
                      {voices.map(v=>(
                        <div key={v.id} className="flex items-center gap-2 p-2 rounded-lg bg-cloud-lavender/50">
                          <span className="text-dream-violet">🎙️</span>
                          <span className="text-sm font-semibold text-midnight-plum flex-1">{v.voice_name}</span>
                          <button onClick={()=>{DB.delete_('family_voices',v.id);setMembers(DB.getFamilyMembers(user.id));}} className="text-red-400 text-xs font-semibold">Delete</button>
                        </div>
                      ))}
                    </div>
                  )}
                </Card>
              );
            })}
          </div>
        )}

        <Button variant="mango" onClick={()=>setShowAdd(true)} full size="lg">Add Family Member</Button>
      </div>

      {/* Add Member Modal */}
      <Modal open={showAdd} onClose={()=>setShowAdd(false)} title="Add Family Member">
        <div className="space-y-3">
          {RELATIONSHIPS.map(r=>(
            <button key={r.id} onClick={()=>handleAddMember(r)} className="w-full flex items-center gap-3 p-3 rounded-xl bg-cloud-lavender/50 hover:bg-cloud-lavender transition-all active:scale-95">
              <span className="text-2xl">{r.avatar}</span>
              <div className="text-left"><div className="font-bold text-midnight-plum">{r.name}</div><div className="text-xs text-midnight-plum/50">{r.label}</div></div>
            </button>
          ))}
        </div>
      </Modal>

      {/* Recording Modal */}
      <Modal open={showRecord} onClose={()=>{if(isRecording){stopRecording();}}} title={`Recording ${recordFor?.name||''}'s Voice`}>
        <div className="flex flex-col items-center py-6">
          <div className={`w-20 h-20 rounded-full flex items-center justify-center text-3xl ${isRecording?'bg-red-500 animate-pulse-soft':'bg-dream-violet'}`}>
            {isRecording?'⏺':'✓'}
          </div>
          <div className="text-2xl font-bold text-midnight-plum mt-3">{fmtTime(recTime)}</div>
          <p className="text-sm text-midnight-plum/60 mt-1">{isRecording?'Recording... Speak naturally':'Recording complete!'}</p>
          {isRecording ? (
            <Button variant="danger" onClick={stopRecording} className="mt-4" size="lg">Stop Recording</Button>
          ) : (
            <Button variant="primary" onClick={()=>setShowRecord(false)} className="mt-4">Done</Button>
          )}
        </div>
      </Modal>
    </div>
  );
}

