const PlayerContext = createContext(null);
function PlayerProvider({children}) {
  const [playing, setPlaying] = useState(false);
  const [story, setStory] = useState(null);
  const [voice, setVoice] = useState(null);
  const [progress, setProgress] = useState({current:0,total:0,percent:0});
  const [volume, setVolumeState] = useState(0.8);
  const [speed, setSpeedState] = useState(1);
  const [sleepTimer, setSleepTimer] = useState(null);
  const [timerRemaining, setTimerRemaining] = useState(null);
  const timerRef = useRef(null);
  const progressRef = useRef(null);
  const audioRef = useRef(null);

  useEffect(() => {
    audioRef.current = AudioEngine.init();
    audioRef.current.volume = volume;
  }, []);

  useEffect(() => {
    const audio = audioRef.current;
    if(!audio) return;
    const update = () => {
      const p = AudioEngine.getProgress();
      setProgress(p);
    };
    const onPlay = () => setPlaying(true);
    const onPause = () => setPlaying(false);
    const onEnded = () => { setPlaying(false); if(sleepTimer) clearSleepTimer(); };
    audio.addEventListener('timeupdate', update);
    audio.addEventListener('play', onPlay);
    audio.addEventListener('pause', onPause);
    audio.addEventListener('ended', onEnded);
    return () => {
      audio.removeEventListener('timeupdate', update);
      audio.removeEventListener('play', onPlay);
      audio.removeEventListener('pause', onPause);
      audio.removeEventListener('ended', onEnded);
    };
  }, [sleepTimer]);

  const playStory = useCallback(async (storyObj, voiceObj, audioSrc) => {
    setStory(storyObj);
    setVoice(voiceObj);
    if(audioSrc) {
      const ok = await AudioEngine.play(audioSrc);
      setPlaying(ok);
    }
  }, []);

  const togglePlay = useCallback(() => {
    if(playing) { AudioEngine.pause(); setPlaying(false); }
    else { AudioEngine.resume(); setPlaying(true); }
  }, [playing]);

  const stop = useCallback(() => {
    AudioEngine.stop();
    setPlaying(false);
    setStory(null);
    setVoice(null);
    setProgress({current:0,total:0,percent:0});
  }, []);

  const seek = useCallback((time) => { AudioEngine.seek(time); }, []);
  const setVolume = useCallback((v) => { setVolumeState(v); AudioEngine.setVolume(v); }, []);
  const setSpeed = useCallback((s) => { setSpeedState(s); AudioEngine.setSpeed(s); }, []);

  const startSleepTimer = useCallback((minutes) => {
    if(timerRef.current) clearInterval(timerRef.current);
    const endTime = Date.now() + minutes * 60 * 1000;
    setSleepTimer(minutes);
    setTimerRemaining(minutes * 60);
    timerRef.current = setInterval(() => {
      const rem = Math.round((endTime - Date.now()) / 1000);
      if(rem <= 0) {
        AudioEngine.pause();
        setPlaying(false);
        setSleepTimer(null);
        setTimerRemaining(null);
        clearInterval(timerRef.current);
      } else {
        setTimerRemaining(rem);
      }
    }, 1000);
  }, []);

  const clearSleepTimer = useCallback(() => {
    if(timerRef.current) clearInterval(timerRef.current);
    setSleepTimer(null);
    setTimerRemaining(null);
  }, []);

  return <PlayerContext.Provider value={{playing,story,voice,progress,volume,speed,sleepTimer,timerRemaining,playStory,togglePlay,stop,seek,setVolume,setSpeed,startSleepTimer,clearSleepTimer}}>{children}</PlayerContext.Provider>;
}
function usePlayer() { return useContext(PlayerContext); }


